# Copy to .env (never commit .env). OpenAI is the default provider.
OPENAI_API_KEY=

# Optional: defaults to gpt-4o-mini
# CHARTER_EXTRACTION_MODEL=gpt-4o-mini

# Optional: Azure OpenAI or compatible proxy
# OPENAI_BASE_URL=https://...

# Use local Ollama instead of OpenAI:
# CHARTER_LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434

# For long Part II on small context models: extract with --page-markers and set:
# OLLAMA_CHUNK=1
